pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Récupération du code source...'
                checkout scm
            }
        }
        stage('Install') {
            steps {
                echo 'Installation des dépendances...'
                dir('cv-onepage/portfolio-nextjs') {
                    sh 'npm ci'
                }
                dir('cv-onepage/api') {
                    sh 'npm ci'
                }
            }
        }
        stage('Test Frontend') {
            steps {
                echo 'Test du frontend...'
                dir('cv-onepage/portfolio-nextjs') {
                    sh 'npm test'
                }
            }
        }
        stage('Test API') {
            steps {
                echo 'Test de l API...'
                dir('cv-onepage/api') {
                    sh 'npm test'
                }
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline terminé.'
        }
    }
}