pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Récupération du code source...'
                checkout scm
            }
        }
        stage('Install') {
            steps {
                echo 'Installation des dépendances...'
                dir('cv-onepage/portfolio-nextjs') {
                    sh 'npm ci'
                }
                dir('cv-onepage/api') {
                    sh 'npm ci'
                }
            }
        }
        stage('Test Frontend') {
            steps {
                echo 'Test du frontend...'
                dir('cv-onepage/portfolio-nextjs') {
                    sh 'npm test'
                }
            }
        }
        stage('Test API') {
            steps {
                echo 'Test de l API...'
                dir('cv-onepage/api') {
                    sh 'npm test'
                }
            }
        }
        stage('Audit') {
            steps {
                echo 'Contrôle des dépendances (npm audit)...'
                dir('cv-onepage/portfolio-nextjs') {
                    sh 'npm audit || true'
                }
                dir('cv-onepage/api') {
                    sh 'npm audit || true'
                }
            }
        }
        stage('Gitleaks') {
            steps {
                echo 'Scan des secrets avec Gitleaks...'
                sh 'gitleaks detect --source . --verbose || true'
            }
        }
        stage('Semgrep') {
            steps {
                echo 'SAST avec Semgrep...'
                sh 'semgrep --config=auto --error || true'
            }
        }
        stage('Dependency-Check') {
            steps {
                echo 'OWASP Dependency-Check...'
                sh 'dependency-check --scan cv-onepage/portfolio-nextjs --scan cv-onepage/api --format HTML --out dependency-check-report.html || true'
            }
        }
        stage('Trivy') {
            steps {
                echo 'Scan des images Docker avec Trivy...'
                sh 'trivy image maryemelheni/garderie-frontend:latest || true'
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline terminé.'
        }
    }
}