pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Recuperation du code source...'
                checkout scm
            }
        }
        stage('Build Frontend') {
            steps {
                echo 'Construction de l image frontend...'
                sh 'docker build -t maryemelheni/garderie-frontend:latest ./frontend'
            }
        }
        stage('Build Backend') {
            steps {
                echo 'Construction de l image backend...'
                sh 'docker build -t maryemelheni/garderie-backend:latest ./backend'
            }
        }
        stage('Push Frontend') {
            steps {
                echo 'Push de l image frontend (ignore car deja sur Docker Hub)...'
            }
        }
        stage('Push Backend') {
            steps {
                echo 'Push de l image backend (ignore car deja sur Docker Hub)...'
            }
        }
    }
        stage('Update GitOps Repo') {
            steps {
                sh '''
                    cd /tmp
                    rm -rf devsecops-portfolio-gitops
                    git clone git@github.com:meryemelheni/devsecops-portfolio-gitops.git
                    cd devsecops-portfolio-gitops
                    sed -i "s|portfolio/api:.*|portfolio/api:${GIT_COMMIT}|" apps/portfolio/base/api-deployment.yaml
                    git config user.email "jenkins@example.com"
                    git config user.name "Jenkins"
                    git add .
                    git commit -m "ci: mise a jour image API ${GIT_COMMIT}" || true
                    git push origin main
                '''
            }
        }
}
